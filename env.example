# Required
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
ADMIN_PASSWORD=change-this-to-a-long-unique-password
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Stripe test keys first; switch to live keys only when ready to accept real payments
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Your deployed site URL, e.g. https://allan-store.onrender.com
SITE_URL=http://localhost:3000
NODE_ENV=development
